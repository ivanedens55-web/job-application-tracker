# Copy to .env and fill in. Never commit .env.

# Supabase > Connect > Session pooler. Use the restricted app role, not postgres.
# The pooler username is the role name plus your project ref: jobtracker_app.<project-ref>
DATABASE_URL=postgresql://jobtracker_app.your-project-ref:your-app-role-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# At least 32 random characters. Generate one in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

ACCESS_TOKEN_MINUTES=30

# Comma-separated exact origins. Never "*".
CORS_ORIGINS=http://localhost:3000

# "production" turns on HSTS and turns off /docs
ENVIRONMENT=development

# Only for running the database tests locally (a THROWAWAY database whose name contains "test").
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobtracker_test
